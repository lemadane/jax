+package com.lemadane.jax.json.internal;
+
+import java.util.List;
+import java.util.Optional;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import com.lemadane.jax.Jax;
+import com.lemadane.jax.JsonProperty;
+
+import static org.assertj.core.api.Assertions.*;
+
+class JsonDirectReaderTest {
+  public static class Child {
+    public String log$colon$Name;
+    @JsonProperty public void setLog$colon$Name(String value) {
+      log$colon$Name = value;
+    }
+  }
+
+  public static class Constructed {
+    public final int value;
+    public Constructed(int value) {
+      this.value = value;
+    }
+  }
+
+  public static class Envelope {
+    public int count;
+    public List<Child> children;
+    public int[] numbers;
+    public Optional<List<Child>> optional;
+    public Constructed constructed;
+    @JsonProperty public void setCount(int value) {
+      count = value;
+    }
+    @JsonProperty public void setChildren(List<Child> value) {
+      children = value;
+    }
+    @JsonProperty public void setNumbers(int[] value) {
+      numbers = value;
+    }
+    @JsonProperty public void setOptional(Optional<List<Child>> value) {
+      optional = value;
+    }
+    @JsonProperty public void setConstructed(Constructed value) {
+      constructed = value;
+    }
+  }
+
+  public static class SideEffects {
+    static int constructions;
+    static int writes;
+    public SideEffects() {
+      constructions++;
+    }
+    @JsonProperty public void setCount(int value) {
+      writes++;
+    }
+  }
+
+  public static class Throwing {
+    @JsonProperty public void setCount(int value) {
+      throw new IllegalStateException("setter failed");
+    }
+  }
+
+  @Test
+  void matchesTreeBindingForNestedPojosGenericsArraysAndConstructorFallback() {
+    String input = """
+        {"count":3,"children":[{"log:Name":"first"},null,{}],"numbers":[1,2,3],
+         "optional":[{"log:Name":"optional"}],"constructed":{"value":7}}
+        """;
+    Envelope actual = Jax.toObject(input, Envelope.class);
+    Envelope expected = JsonObjectReader.readTree(input, Envelope.class, true);
+    assertThat(Jax.toJson(actual)).isEqualTo(Jax.toJson(expected));
+    assertThat(actual.children.get(0)).isInstanceOf(Child.class);
+    assertThat(actual.children.get(0).log$colon$Name).isEqualTo("first");
+    assertThat(actual.constructed.value).isEqualTo(7);
+    assertThat(actual.numbers).containsExactly(1, 2, 3);
+    assertThatThrownBy(() -> actual.children.clear()).isInstanceOf(UnsupportedOperationException.class);
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"{}", "{\"numbers\":[],\"children\":[],\"optional\":null}",
+      "{\"numbers\":null,\"children\":null,\"optional\":[]}",
+      "{\"unknown\":{\"nested\":[1,null,true]},\"count\":2}"})
+  void preservesPartialDefaultsAndUnknownPropertySkipping(String input) {
+    assertThat(Jax.toJson(JsonObjectReader.toObject(input, Envelope.class, false)))
+        .isEqualTo(Jax.toJson(JsonObjectReader.readTree(input, Envelope.class, false)));
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"", "{", "{\"count\":", "{\"count\":1,}", "{\"count\":1} trailing",
