+      "{\"count\":1e10001}", "{\"count\":1e}", "{\"count\":1.}", "{\"count\":01}",
+      "{\"count\":tru}", "{\"count\":nul}", "{\"count\":\"\\x\"}", "{\"children\":[}",
+      "{\"unknown\":1}", "{\"count\":null}", "{\"numbers\":true}", "{\"children\":[3]}",
+      "{\"constructed\":{\"wrong\":1}}", "[]", "null", "true", "42", "\"text\""})
+  void preservesSyntaxAndMappingErrors(String input) {
+    Throwable expected = catchThrowable(() -> JsonObjectReader.readTree(input, Envelope.class, true));
+    assertThat(expected).isNotNull();
+    assertThatThrownBy(() -> JsonObjectReader.toObject(input, Envelope.class, true))
+        .isExactlyInstanceOf(expected.getClass()).hasMessage(expected.getMessage());
+  }
+
+  @Test
+  void validatesEntireDocumentBeforeInvokingUserCode() {
+    SideEffects.constructions = 0;
+    SideEffects.writes = 0;
