+package com.lemadane.jax.json.internal;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.*;
+
+class JsonValidationPassTest {
+  @Test
+  void acceptsTheSameEscapesAndNumericBoundsAsTheTreeParser() {
+    List<String> inputs = List.of("null", "true", "false", "0", "-0", "-1.25e+2", "1e10000", "1e-10000",
+        "[{},[],null,\"plain😀\"]", "\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"",
+        "\"\\u0041\\uD83D\\uDE00\\uD800\\u0042\"", "1e" + "0".repeat(100) + "1",
+        "{\"escaped\\u003Akey\":\"value\"}");
+    for (String input : inputs) {
+      JsonParser.parse(input);
+      assertThatCode(() -> JsonParser.validate(input)).doesNotThrowAnyException();
+    }
+  }
+
+  @Test
+  void rejectsTheSameMalformedStringsAndLimitsAsTheTreeParser() {
+    List<String> inputs = List.of("\"unterminated", "\"ends in \\", "\"\\x\"", "\"raw\nnewline\"",
+        "\"\\u12\"", "\"\\uZZZZ\"", "\"\\uD800\\uZZZZ\"", "[\"ok\",{\"x\":\"\\x\"}]",
+        "1".repeat(1025), "1e10001", "1e-10001", "1e999999999999", "[".repeat(257) + "0" + "]".repeat(257));
+    for (String input : inputs) {
+      Throwable expected = catchThrowable(() -> JsonParser.parse(input));
+      assertThat(expected).isNotNull();
+      assertThatThrownBy(() -> JsonParser.validate(input)).isExactlyInstanceOf(expected.getClass()).hasMessage(expected.getMessage());
+    }
+  }
+}
