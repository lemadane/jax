+package com.lemadane.jax.json.internal;
+
+import java.lang.reflect.Array;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Type;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Optional;
+
+import com.lemadane.jax.convert.TypeConverter;
+import com.lemadane.jax.exceptions.ExcessDataException;
+import com.lemadane.jax.exceptions.JsonMappingException;
+import com.lemadane.jax.naming.DataNameCodec;
+
+/** Direct binding for no-argument POJOs, with the full mapper as a fallback. */
+final class JsonDirectReader {
+   JsonDirectReader() {
+  }
+
+  static <T> T read(String json, Class<T> type, boolean strict) {
+    // Preserve the original contract: malformed input never invokes user code.
+    JsonParser.validate(json);
+    JsonParser parser = new JsonParser(json);
+    parser.skipWhitespace();
+    if (parser.json.charAt(parser.pos) != '{') {
+      var node = parser.parseValue("$", 0);
+      throw new JsonMappingException("A JSON object is expected but " + JsonObjectReader.describe(node) + " was supplied at $");
+    }
+    return readObject(parser, type, "$", 1, strict);
+  }
+
+   static <T> T readObject(JsonParser parser, Class<T> type, String path, int depth, boolean strict) {
+    parser.pos++; // Opening brace; syntax has already been validated.
+    T instance = JsonObjectReader.createInstance(type);
+    parser.skipWhitespace();
+    if (parser.json.charAt(parser.pos) == '}') {
+      parser.pos++;
+      return instance;
+    }
+    while (true) {
+      parser.skipWhitespace();
+      String name = parser.parseStringValue(path);
+      String propertyPath = path + "." + name;
+      parser.skipWhitespace();
+      parser.pos++; // Colon.
+      var setter = JsonObjectReader.findSetter(type, name, propertyPath);
+      if (setter == null) {
+        String encoded = DataNameCodec.encode(name);
+        if (!encoded.equals(name)) {
+          setter = JsonObjectReader.findSetter(type, encoded, propertyPath);
+        }
+      }
+      if (setter == null) {
+        if (strict) {
+          throw new ExcessDataException("No setter for JSON property \"" + name + "\" on " + type.getName() + " at " + propertyPath);
+        }
+        parser.parseValue(propertyPath, depth);
+      } else {
+        Object value = readValue(parser, setter.getParameterTypes()[0], setter.getGenericParameterTypes()[0],
+            propertyPath, depth, strict);
+        try {
+          setter.invoke(instance, value);
+        } catch (InvocationTargetException e) {
+          Throwable cause = e.getCause() != null ? e.getCause() : e;
+          throw new JsonMappingException("Setter for property \"" + name + "\" failed at " + propertyPath, cause);
+        } catch (ReflectiveOperationException | IllegalArgumentException e) {
+          throw new JsonMappingException("Failed to set property \"" + name + "\" at " + propertyPath, e);
+        }
+      }
+      parser.skipWhitespace();
+      if (parser.json.charAt(parser.pos++) == '}') {
+        return instance;
+      }
+    }
+  }
+
+   static Object readValue(JsonParser parser, Class<?> type, Type genericType, String path, int depth, boolean strict) {
+    parser.skipWhitespace();
+    char token = parser.json.charAt(parser.pos);
+    if (token != 'n' && Optional.class.isAssignableFrom(type)) {
+      Type inner = JsonObjectReader.getGenericTypeArgument(genericType);
+      return Optional.ofNullable(readValue(parser, JsonObjectReader.rawType(inner), inner, path, depth, strict));
+    }
+    if (token == '{' && JsonObjectReader.hasOnlyDefaultConstructor(type)
+        && type != Object.class && !List.class.isAssignableFrom(type) && !type.isArray()) {
+      return readObject(parser, type, path, depth + 1, strict);
+    }
+    if (token == '[' && (List.class.isAssignableFrom(type) || type.isArray())) {
+      Type element = type.isArray() ? type.getComponentType() : JsonObjectReader.getGenericTypeArgument(genericType);
+      Class<?> elementType = JsonObjectReader.rawType(element);
+      List<Object> values = new ArrayList<>();
+      parser.pos++;
+      parser.skipWhitespace();
+      if (parser.json.charAt(parser.pos) == ']') {
+        parser.pos++;
+      } else {
+        int index = 0;
+        while (true) {
+          values.add(readValue(parser, elementType, element, path + "[" + index++ + "]", depth + 1, strict));
+          parser.skipWhitespace();
+          if (parser.json.charAt(parser.pos++) == ']') {
+            break;
+          }
+        }
+      }
+      if (!type.isArray()) {
+        return Collections.unmodifiableList(values);
+      }
+      Object array = Array.newInstance(elementType, values.size());
+      for (int i = 0; i < values.size(); i++) {
+        Array.set(array, i, values.get(i));
+      }
+      return array;
+    }
+    if (token == '"' && !List.class.isAssignableFrom(type) && !type.isArray()) {
+      return TypeConverter.convert(type, parser.parseStringValue(path), path);
+    }
+    // Constructor selection, scalar conversion and unusual types retain the
+    // existing semantics. Only this value needs a tree on the fallback path.
+    return JsonObjectReader.readValue(type, genericType, parser.parseValue(path, depth), path, strict);
+  }
+}
