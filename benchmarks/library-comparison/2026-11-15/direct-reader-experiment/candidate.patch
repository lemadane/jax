+    assertThat(SideEffects.writes).isZero();
+    Jax.toObject("{\"count\":1}", SideEffects.class);
+    assertThat(SideEffects.constructions).isEqualTo(1);
+    assertThat(SideEffects.writes).isEqualTo(1);
