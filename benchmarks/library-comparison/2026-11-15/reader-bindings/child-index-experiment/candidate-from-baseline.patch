+  static Map<String, List<XmlElement>> indexChildren(List<XmlElement> elements) {
+    if (elements.isEmpty()) {
+      return Map.of();
+    }
+    Map<String, List<XmlElement>> byName = new HashMap<>();
+    for (XmlElement element : elements) {
+      String decodedName = DataNameCodec.decode(element.name());
+      addChild(byName, decodedName, element);
+      if (!decodedName.equals(element.name())) {
+        addChild(byName, element.name(), element);
+      }
+    }
+    return byName;
+  }
+
+   static void addChild(Map<String, List<XmlElement>> byName, String name, XmlElement element) {
+    List<XmlElement> matches = byName.get(name);
+    if (matches == null) {
+      byName.put(name, List.of(element));
+    } else {
+      if (matches.size() == 1) {
+        matches = new ArrayList<>(matches);
+        byName.put(name, matches);
+      }
+      matches.add(element);
+    }
+  }
